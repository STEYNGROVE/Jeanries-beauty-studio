(()=>{'use strict';const q=document.querySelector('#q'),results=document.querySelector('#results'),count=document.querySelector('#count'),viewer=document.querySelector('#viewer');let pages=[];const pdf='/catalogues/justine-november-2026.pdf';function render(){const words=q.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);results.replaceChildren();if(!words.length){count.textContent='100 brochure pages available. Enter a product name or code to search.';return}const matches=pages.filter(p=>words.every(w=>p.text.toLocaleLowerCase().includes(w)));count.textContent=matches.length+' matching page(s)';for(const p of matches.slice(0,100)){const card=document.createElement('article');const h=document.createElement('h3');h.textContent='Page '+p.page;const preview=document.createElement('p');const text=p.text;let pos=Math.max(0,text.toLocaleLowerCase().indexOf(words[0])-85);preview.textContent=(pos?'…':'')+text.slice(pos,pos+300)+(text.length>pos+300?'…':'');const link=document.createElement('a');link.href=pdf+'#page='+p.page;link.target='_blank';link.rel='noopener';link.textContent='Open PDF page';const ask=document.createElement('a');ask.href='https://wa.me/27822265134?text='+encodeURIComponent('Hello Jeanrie, please confirm the current price and availability for a Justine product from the November 2026 brochure, page '+p.page+'. My product is: '+q.value.trim());ask.target='_blank';ask.rel='noopener';ask.textContent='Enquire on WhatsApp';const jump=document.createElement('button');jump.type='button';jump.textContent='Show below';jump.addEventListener('click',()=>{viewer.src=pdf+'#page='+p.page;viewer.scrollIntoView({behavior:'smooth'});});card.append(h,preview,link,document.createTextNode(' '),ask,document.createElement('br'),jump);results.append(card)}}fetch('/data/justine-november-2026-pages.json').then(r=>{if(!r.ok)throw Error('Index unavailable');return r.json()}).then(d=>{pages=d.pages;q.addEventListener('input',render);render()}).catch(()=>count.textConte